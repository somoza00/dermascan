# URL da API. Em dev local (npm run dev), o fallback em src/services/api.ts
# já aponta pra http://localhost:8000 — só precisa disto pra apontar pra
# uma API remota (ex.: em produção, no build da Vercel).
VITE_API_URL=http://localhost:8000

# Resultados aleatórios da API em modo mock são bloqueados por padrão. Habilite
# apenas para uma demonstração explicitamente identificada.
VITE_ALLOW_MOCK_RESULTS=false
