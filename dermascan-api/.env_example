# Configuração da API
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Origens liberadas no CORS, separadas por vírgula (sem wildcard em produção)
CORS_ORIGINS=http://localhost:5173,https://seu-frontend.vercel.app

# Caminho local ou URL HTTPS do checkpoint treinado. Sem isso, a API usa
# dermascan-api/models/dermascan_v1.pt por padrão.
MODEL_PATH=

# Obrigatório se MODEL_PATH for uma URL remota. Use o SHA-256 de 64 caracteres
# publicado junto ao checkpoint para garantir a integridade do download.
MODEL_SHA256=

# Em CPU, uma inferência por vez protege o processo de um pico de uploads.
# Aumente somente após medir latência e RAM no hardware do deploy.
MAX_CONCURRENT_INFERENCES=1

# Limite local por IP/processo. Configure limite equivalente no proxy/CDN se
# houver mais de uma réplica da API.
MAX_PREDICTIONS_PER_MINUTE=20

# Sem checkpoint disponível (nem local nem via MODEL_PATH), a API recusa
# subir por padrão — evita servir predições sintéticas silenciosamente em
# produção. Defina true só em dev/CI/demo sem o modelo treinado.
ALLOW_MOCK_INFERENCE=false
